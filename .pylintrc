[MAIN]
# Minimum runtime supported by the repo (AGENTS.md), not the CI matrix version.
py-version = 3.11
jobs = 0

[MESSAGES CONTROL]
# Ruff owns formatting, naming and refactor style in this repository. Pylint is
# kept as a correctness gate: errors and warnings stay on, convention/refactor
# noise is off. `unused-argument` is disabled because Hermes hook signatures are
# fixed by the host, and `broad-exception-caught` because guard code fails closed
# by catching broad exceptions.
disable =
    C,
    R,
    unused-argument,
    broad-exception-caught

[TYPECHECK]
# The plugin imports the Hermes host (`agent.*`), tests import `hermes_cli`,
# and the diagram generators import Pillow plus their sibling `_font` helper;
# none is installed in this job. Exempting only those modules keeps
# import-error enabled, so typos in standard-library or first-party imports
# are still caught.
ignored-modules =
    agent,
    hermes_cli,
    PIL,
    _font
