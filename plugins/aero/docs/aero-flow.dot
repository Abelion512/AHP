digraph Aero {
 graph [rankdir=TB,bgcolor="#f6f8fc",pad="0.35",nodesep="0.35",ranksep="0.35",fontname="Arial",label="Aero | bounded native cards",labelloc=t,fontsize=22];
 node [shape=box,style="rounded,filled",fillcolor="white",color="#ccd8e8",fontname="Arial",fontsize=13,margin="0.18,0.12"];
 edge [color="#53739e",fontname="Arial",fontsize=11];
 request [label="Ordinary user request\nprocedure / status / comparison / short form"];
 skill [label="Bundled Aero skill\nselect kind + bounded text attributes"];
 directive [label="Assistant reply: ::ui{version=1, id, kind, ...}\nGuidance, not guaranteed live-model compliance"];
 parser [label="Host transcript parser\npinned core fixture, 2048-character body cap",fillcolor="#e9f1ff"];
 renderer [label="Aero native React renderer\nwizard | status | trace | compare | form",fillcolor="#e9f1ff"];
 validate [label="Version/kind check + text caps\nstreaming placeholder, no HTML or model JS"];
 state [label="Wizard state\nowner session + explicit card id\nform values not persisted"];
 action [label="User clicks\nmessage <=240 characters + owning session required"];
 bridge [label="host.composer.submit(owner, text)\ntrue = accepted, not task completion",fillcolor="#e7f6ee"];
 refuse [label="Missing owner / refusal / throw / overflow\nvisible error, no focused-chat fallback",fillcolor="#fff0ec"];
 tests [label="Verified: real parser + React + Chromium\nFake SDK bridge; desktop + 390px mobile\nNot a live host install or live-model evaluation",fillcolor="#fff7dd"];
 request -> skill -> directive -> parser -> renderer -> validate;
 validate -> state; validate -> action; action -> bridge [label="valid"];
 action -> refuse [label="invalid"];
 bridge -> refuse [label="refused / throw"];
 renderer -> tests [style=dashed];
}
